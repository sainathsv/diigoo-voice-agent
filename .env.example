# Local development. Copy to .env and adjust.
# Owner role runs migrations; app role is subject to row-level security;
# platform role (BYPASSRLS) is used ONLY by the Diigoo console after a platform permission check.
DATABASE_OWNER_URL=postgres://jenai_owner:jenai_owner_dev@localhost:5432/jenai_platform
DATABASE_URL=postgres://jenai_app:jenai_app_dev@localhost:5432/jenai_platform
DATABASE_PLATFORM_URL=postgres://jenai_platform:jenai_platform_dev@localhost:5432/jenai_platform
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3100
SEED_PASSWORD=Jenai@Dev2026
